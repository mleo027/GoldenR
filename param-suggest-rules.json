{
  "rules": [
    {
      "id": "rule-bsflag-global",
      "field": "bsflag",
      "fields": ["bsflag"],
      "type": "select",
      "enabled": true,
      "priority": 0,
      "match": { "when": { "bsflag": "" } },
      "datasource": {
        "type": "sql",
        "db": "mssql",
        "sql": "select distinct value = bsflag, remark = remark from run.dbo.bsconfig where bsflag like '%'+@bsflag+'%'",
        "cache": { "enabled": true, "ttlSeconds": 300 },
        "trigger": "focus"
      }
    },
    {
      "id": "rule-orgid-global",
      "field": "orgid",
      "fields": ["orgid", "custorgid"],
      "type": "select",
      "enabled": true,
      "priority": 0,
      "datasource": {
        "type": "sql",
        "db": "mssql",
        "sql": "select value = orgid, remark = orgname from run.dbo.org",
        "cache": { "enabled": true, "ttlSeconds": 300 },
        "trigger": "focus"
      }
    },
    {
      "id": "rule-mqlpvkud-f1w2bj",
      "field": "operid",
      "fields": ["operid", "g_operid"],
      "type": "select",
      "enabled": true,
      "priority": 0,
      "datasource": {
        "type": "sql",
        "db": "mssql",
        "sql": "select value=operid,remark = opername\nfrom operator\nwhere orgid = @orgid?\n  and operid like '%'+@g_operid?+'%'",
        "cache": { "enabled": true, "ttlSeconds": 300 },
        "trigger": "focus"
      }
    },
    {
      "id": "rule-mqlq9bn5-y2gom3",
      "field": "market",
      "fields": ["market"],
      "type": "select",
      "enabled": true,
      "priority": 0,
      "datasource": {
        "type": "sql",
        "db": "mssql",
        "sql": "select value=market, remark = marketid from run.dbo.market",
        "cache": { "enabled": true, "ttlSeconds": 300 },
        "trigger": "focus"
      }
    },
    {
      "id": "rule-mqlqchxy-pzjiq8",
