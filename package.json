{
  "name": "golden-api-debug",
  "private": true,
  "version": "0.0.0",
  "description": "Golden API standalone KCBP API debugger",
  "author": "Your Name",
  "main": "dist-electron/main.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "config": {
    "electron_mirror": "https://npmmirror.com/mirrors/electron/",
    "electron_builder_binaries_mirror": "https://npmmirror.com/mirrors/electron-builder-binaries/"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "dev": "vite",
    "build": "npm run generate:icon && npm run prepare:node && tsc && vite build && node scripts/verify-kuab-credentials.mjs && electron-builder",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run src/shared src/architecture src/test src/modules/api-debug/utils src/modules/api-debug/services src/modules/api-debug/store electron/config electron/ipc electron/services electron/app --exclude \"**/*.integration.test.tsx\"",
    "test:component": "vitest run src/modules/api-debug/components --exclude \"**/*.integration.test.tsx\" --environment jsdom",
    "test:integration": "vitest run src/modules/api-debug/providers/kcbpCallProvider.integration.test.tsx src/modules/api-debug/providers/tabsActions.integration.test.tsx src/modules/api-debug/components/editor/path.integration.test.tsx src/modules/api-debug/components/settings/paramSuggestRulesSettings.integration.test.tsx",
    "test:smoke": "vitest run src/smoke --passWithNoTests",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "smoke:dev": "node scripts/smoke-dev.mjs",
    "build:native": "node scripts/build-native.mjs",
    "test:watch": "vitest",
    "test:related": "vitest related --run",
    "test:api": "npm run test:database && npm run test:kcbp && npm run test:import && npm run test:script && npm run test:suggest && npm run test:persist && npm run test:core",
    "test:database": "node scripts/run-unit-tests.mjs database",
    "test:kcbp": "node scripts/run-unit-tests.mjs kcbp",
    "test:import": "node scripts/run-unit-tests.mjs import",
    "test:script": "node scripts/run-unit-tests.mjs script",
    "test:suggest": "node scripts/run-unit-tests.mjs suggest",
    "test:persist": "node scripts/run-unit-tests.mjs persist",
    "test:core": "node scripts/run-unit-tests.mjs core",
    "ipc:check": "node scripts/verify-ipc-integrity.mjs",
    "check:kuab": "node scripts/verify-kuab-credentials.mjs --strict",
    "staged:check": "node scripts/verify-staged-guards.mjs && node scripts/check-color-budget.mjs",
    "color:check": "node scripts/check-color-budget.mjs",
    "commit:check": "npm run staged:check && npm run ipc:check && npm run typecheck && npm run lint",
    "check:delivery": "npm run check && npm run test:api && npx vite build",
    "scan:encoding": "node scripts/scan-garbled-strings.mjs",
    "check:complexity": "node scripts/check-complexity.mjs",
    "check": "npm run lint && npm run ipc:check && npm run format:check && npm run scan:encoding && npm run check:complexity && npm run typecheck && npm run test:component && npm run test",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"electron/**/*.{ts,json,sql}\" \"docs/**/*.md\" \"AGENTS.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"electron/**/*.{ts,json,sql}\" \"docs/**/*.md\" \"AGENTS.md\"",
    "generate:icon": "node scripts/generate-icon.mjs",
    "prepare:node": "node scripts/copy-node-runtime.mjs"
  },
  "build": {
    "appId": "com.yourcompany.golden-api-debug",
    "productName": "Golden API",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "electronVersion": "36.3.1",
    "asar": true,
    "asarUnpack": [
      "dist-electron/kcbpBridge.cjs",
      "**/*.node"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": null,
    "extraResources": [
      {
        "from": "electron/adapter",
        "to": "adapter"
      },
      {
        "from": "resources/node",
        "to": "node"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist/win-unpacked/**/*",
      "!dist/*.exe",
      "!dist/*.exe.blockmap",
      "!dist/builder-debug.yml",
      "!node_modules/**/*"
    ],
    "npmRebuild": true,
    "buildDependenciesFromSource": false
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@tailwindcss/vite": "^4.1.7",
    "@types/better-sqlite3": "^9.6.0",
    "@uiw/react-codemirror": "^4.25.10",
    "antd": "^5.25.2",
    "better-sqlite3": "^13.0.3",
    "iconv-lite": "^0.7.2",
    "mssql": "^12.5.5",
    "rc-virtual-list": "^3.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^3.0.2",
    "sql-formatter": "^15.8.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.1.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/mssql": "12.3.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "electron": "^36.3.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.25.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^30.0.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-sql": "^0.20.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.1.7",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^4.1.9"
  }
}
